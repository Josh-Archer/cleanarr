CLEANARR_PLEX_BASEURL=http://plex:32400
CLEANARR_PLEX_TOKEN=replace-me
CLEANARR_SONARR_BASEURL=http://sonarr:8989/api/v3/
CLEANARR_SONARR_APIKEY=replace-me
CLEANARR_RADARR_BASEURL=http://radarr:7878/api/v3/
CLEANARR_RADARR_APIKEY=replace-me
CLEANARR_TRANSMISSION_HOST=transmission
CLEANARR_TRANSMISSION_PORT=9091
CLEANARR_TRANSMISSION_USERNAME=transmission
CLEANARR_TRANSMISSION_PASSWORD=replace-me
CLEANARR_DRY_RUN=true
# Optional Leaving Soon window; zero preserves immediate deletion behavior.
CLEANARR_GRACE_DAYS=0
# Set a collection name to publish pending items on Plex Home / Recommended.
CLEANARR_LEAVING_SOON_COLLECTION=
# Mount this path on persistent storage shared with webhook runtimes.
CLEANARR_LEAVING_SOON_STATE_FILE=/logs/leaving-soon-state.json
# Job-mode only: per-user dry-run JSON + Markdown artifacts (not written by webhook).
CLEANARR_DRY_RUN_REPORT_DIR=/logs/dry-run-reports
CLEANARR_LOG_FILE=/logs/cleanarr.log
CLEANARR_NTFY_TOPIC=
CLEANARR_NTFY_BASEURL=https://ntfy.sh
PLEX_WEBHOOK_ENABLE_DELETIONS=false
PLEX_WEBHOOK_PORT=8000
# Optional authenticity: when set, missing/invalid token or HMAC signature is rejected (401).
# Headers: X-Cleanarr-Webhook-Token / X-Webhook-Token, or X-Cleanarr-Signature: sha256=<hex>
WEBHOOK_SECRET=replace-me
WEBHOOK_SECRET_PREVIOUS=
JELLYFIN_WEBHOOK_SECRET=
JELLYFIN_WEBHOOK_SECRET_PREVIOUS=
## Queue mode: set to 'sqs' for staged buffering, or 'direct' for immediate handling.
CLEANARR_WEBHOOK_QUEUE_MODE=direct
CLEANARR_WEBHOOK_QUEUE_URL=
CLEANARR_WEBHOOK_QUEUE_REGION=
CLEANARR_WEBHOOK_QUEUE_ENQUEUING=false
CLEANARR_WEBHOOK_QUEUE_POLLING=false
CLEANARR_WEBHOOK_QUEUE_MAX_MESSAGES=50
CLEANARR_WEBHOOK_QUEUE_WAIT_SECONDS=1
CLEANARR_WEBHOOK_QUEUE_VISIBILITY_TIMEOUT=0
# Proxy sink contract: set CLEANARR_WEBHOOK_QUEUE_URL for direct SQS publishing.
# Keep CLEANARR_WEBHOOK_FORWARD_URL only if you still need Lambda URL fallback.
CLEANARR_WEBHOOK_FORWARD_URL=
TARGET_PLEX_BASEURL=
TARGET_PLEX_TOKEN=
TARGET_PLEX_USER_TOKENS_JSON={}
CLEANARR_USER_ALIASES_JSON={}
# Household multi-user delete policy (issue #20).
# require_all_users | majority | primary_user_only
# Default require_all_users is safest for shared libraries.
CLEANARR_MULTI_USER_DELETE_POLICY=require_all_users
# Optional explicit household roster (comma-separated). When unset, uses
# Sonarr/Radarr user tags, else every account present in watch status.
CLEANARR_HOUSEHOLD_USERS=
# Required when CLEANARR_MULTI_USER_DELETE_POLICY=primary_user_only
CLEANARR_PRIMARY_USER=
# Tag exclusion: comma-separated Sonarr/Radarr exclusion tags (default: keep)
# Items carrying any of these tags are protected and skipped from deletion
CLEANARR_EXCLUSION_TAGS=keep
# Seerr request protection (Overseerr / Jellyseerr)
CLEANARR_SEERR_ENABLE=false
CLEANARR_SEERR_BASEURL=http://overseerr:5055/api/v1
CLEANARR_SEERR_APIKEY=replace-me
CLEANARR_SEERR_WINDOW_DAYS=30
CLEANARR_SEERR_PROTECTED_USERS=

CLEANARR_RADARR_APIKEY=replace-me
# Optional Lidarr music cleanup (default OFF)
CLEANARR_LIDARR_ENABLE=false
CLEANARR_LIDARR_BASEURL=http://lidarr:8686/api/v1/
CLEANARR_LIDARR_APIKEY=
CLEANARR_TRANSMISSION_HOST=transmission
CLEANARR_TRANSMISSION_PORT=9091
CLEANARR_TRANSMISSION_USERNAME=transmission
CLEANARR_TRANSMISSION_PASSWORD=replace-me
CLEANARR_DRY_RUN=true
CLEANARR_LOG_FILE=/logs/cleanarr.log
CLEANARR_NTFY_TOPIC=
CLEANARR_NTFY_BASEURL=https://ntfy.sh
PLEX_WEBHOOK_ENABLE_DELETIONS=false
PLEX_WEBHOOK_PORT=8000
WEBHOOK_SECRET=replace-me
WEBHOOK_SECRET_PREVIOUS=
## Queue mode: set to 'sqs' for staged buffering, or 'direct' for immediate handling.
CLEANARR_WEBHOOK_QUEUE_MODE=direct
CLEANARR_WEBHOOK_QUEUE_URL=
CLEANARR_WEBHOOK_QUEUE_REGION=
CLEANARR_WEBHOOK_QUEUE_ENQUEUING=false
CLEANARR_WEBHOOK_QUEUE_POLLING=false
CLEANARR_WEBHOOK_QUEUE_MAX_MESSAGES=50
CLEANARR_WEBHOOK_QUEUE_WAIT_SECONDS=1
CLEANARR_WEBHOOK_QUEUE_VISIBILITY_TIMEOUT=0

# Media source for job-mode watched state: plex (default), emby, or jellyfin
CLEANARR_MEDIA_SOURCE=plex
CLEANARR_PLEX_BASEURL=http://plex:32400
CLEANARR_PLEX_TOKEN=replace-me

# Emby (required when CLEANARR_MEDIA_SOURCE=emby)
CLEANARR_EMBY_BASEURL=http://emby:8096
CLEANARR_EMBY_APIKEY=replace-me
# Optional: comma-separated Emby usernames (empty = all non-disabled users)
CLEANARR_EMBY_USERS=

# Jellyfin (required when CLEANARR_MEDIA_SOURCE=jellyfin)
CLEANARR_JELLYFIN_BASEURL=http://jellyfin:8096
CLEANARR_JELLYFIN_APIKEY=replace-me
# Optional: comma-separated Jellyfin usernames (empty = all non-disabled users)
CLEANARR_JELLYFIN_USERS=
CLEANARR_SONARR_BASEURL=http://sonarr:8989/api/v3/
CLEANARR_SONARR_APIKEY=replace-me
CLEANARR_RADARR_BASEURL=http://radarr:7878/api/v3/
CLEANARR_RADARR_APIKEY=replace-me
CLEANARR_TRANSMISSION_HOST=transmission
CLEANARR_TRANSMISSION_PORT=9091
CLEANARR_TRANSMISSION_USERNAME=transmission
CLEANARR_TRANSMISSION_PASSWORD=replace-me
CLEANARR_DRY_RUN=true
CLEANARR_LOG_FILE=/logs/cleanarr.log
CLEANARR_NTFY_TOPIC=
CLEANARR_NTFY_BASEURL=https://ntfy.sh
PLEX_WEBHOOK_ENABLE_DELETIONS=false
PLEX_WEBHOOK_PORT=8000
WEBHOOK_SECRET=replace-me
WEBHOOK_SECRET_PREVIOUS=

WEBHOOK_SECRET_PREVIOUS=
# Emby webhook secrets for POST /emby/webhook
EMBY_WEBHOOK_SECRET=
EMBY_WEBHOOK_SECRET_PREVIOUS=
